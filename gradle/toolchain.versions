# Single source of truth for the project-local toolchain.
# scripts/dev and the root Gradle build both read this file; change a version here only.
jdk.version=21.0.12.1+1

# JDK archive per platform. scripts/dev picks the pair matching `uname -s`/`uname -m`.
# Gradle is platform independent, so it keeps a single entry.

# macOS arm64
jdk.mac.arm64.sha256=3623232f33a9c3baadf304480b2535f9a3cba8a58d42ecbb438ba267315d9998
jdk.mac.arm64.url=https://github.com/adoptium/temurin21-binaries/releases/download/jdk-21.0.12.1%2B1/OpenJDK21U-jdk_aarch64_mac_hotspot_21.0.12.1_1.tar.gz

# Linux x64 (GitHub Actions ubuntu-latest / standard Linux server)
jdk.linux.x64.sha256=ce79869e1307ed8ee1e2baa86a412b1eb5b75d10a01006d788a6f968bcfaee94
jdk.linux.x64.url=https://github.com/adoptium/temurin21-binaries/releases/download/jdk-21.0.12.1%2B1/OpenJDK21U-jdk_x64_linux_hotspot_21.0.12.1_1.tar.gz

# Linux arm64
jdk.linux.arm64.sha256=23e37e026f12f3e706f18938ff611db3032d075b09d0879a25d06718c773e223
jdk.linux.arm64.url=https://github.com/adoptium/temurin21-binaries/releases/download/jdk-21.0.12.1%2B1/OpenJDK21U-jdk_aarch64_linux_hotspot_21.0.12.1_1.tar.gz

gradle.version=8.14.3
