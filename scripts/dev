#!/bin/bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd -P)"
LOCAL="$ROOT/.local"
fail() { echo "ERROR: $*" >&2; exit 1; }

# Verified targets: macOS arm64, Linux x64, Linux arm64. The JDK archive is picked per platform.
PLATFORM="$(uname -s)/$(uname -m)"
case "$PLATFORM" in
    Darwin/arm64) JDK_OS=mac; JDK_ARCH=arm64 ;;
    Linux/x86_64 | Linux/amd64) JDK_OS=linux; JDK_ARCH=x64 ;;
    Linux/aarch64 | Linux/arm64) JDK_OS=linux; JDK_ARCH=arm64 ;;
    *) fail "Unsupported platform: $PLATFORM. Verified targets: macOS arm64, Linux x64, Linux arm64." ;;
esac

# Linux ships sha256sum, macOS ships shasum; both read and emit the same "<hash>  <file>" lines.
# Kept as an argv array, not a function: `find -exec` can only run real executables.
if command -v sha256sum >/dev/null 2>&1; then SHA=(sha256sum); else SHA=(shasum -a 256); fi

# gradle/toolchain.versions is the single source for these versions; the root Gradle build reads it too.
VERSIONS_FILE="$ROOT/gradle/toolchain.versions"
[[ -f "$VERSIONS_FILE" ]] || fail "Missing $VERSIONS_FILE: it holds the JDK and Gradle versions and checksums."
version_value() {
    local key="$1" value
    value="$(sed -n "s/^${key}=\(.*\)$/\1/p" "$VERSIONS_FILE" | head -1)"
    [[ -n "$value" ]] || fail "Missing or empty '$key' in $VERSIONS_FILE"
    printf '%s' "$value"
}
JDK_VERSION="$(version_value jdk.version)"
JDK_SHA="$(version_value "jdk.$JDK_OS.$JDK_ARCH.sha256")"
JDK_URL="$(version_value "jdk.$JDK_OS.$JDK_ARCH.url")"
GRADLE_VERSION="$(version_value gradle.version)"
GRADLE_SHA="$(version_value gradle.sha256)"
GRADLE_URL="$(version_value gradle.url)"

JDK_DIR="$LOCAL/jdk/jdk-$JDK_VERSION"
# macOS bundles are wrapped in a .app-like Contents/Home; Linux tarballs are the JDK directory itself.
if [[ "$JDK_OS" == mac ]]; then JDK_HOME="$JDK_DIR/Contents/Home"; else JDK_HOME="$JDK_DIR"; fi

mkdir -p "$LOCAL/jdk" "$LOCAL/gradle-dist" "$LOCAL/gradle-user-home" "$LOCAL/tmp"
verify() { echo "$2  $1" | "${SHA[@]}" -c - >/dev/null; }
fetch() {
    local url="$1" file="$2" sha="$3"
    echo "Source: $url; SHA-256: $sha"
    if [[ -f "$file" ]]; then
        verify "$file" "$sha" || fail "Corrupt archive: $file; remove it and rerun bootstrap."
        echo "Reuse: $file"
    else
        curl --fail --location --retry 2 --connect-timeout 30 --max-time 900 "$url" -o "$file.part"
        verify "$file.part" "$sha" || fail "Checksum mismatch: $file.part"
        mv "$file.part" "$file"
    fi
}
check_install() {
    local dir="$1" manifest="$2"
    # -s matters: GNU `sha256sum -c` on an empty manifest exits 0, which would report an
    # unverified installation as healthy. An absent or empty manifest is never acceptable.
    [[ -d "$dir" && -s "$manifest" ]] || fail "Missing installation/manifest: $dir; run bootstrap (remove incomplete installation first)."
    (cd "$dir" && "${SHA[@]}" -c "$manifest" >/dev/null) || fail "Damaged installation: $dir; remove it and rerun bootstrap."
}
manifest() { (cd "$1" && find . -type f -exec "${SHA[@]}" {} +) > "$2"; }

# Adoptium archives wrap the JDK in a versioned top-level directory whose name is not
# guaranteed to match ours; extract to a staging dir so we can normalize it deterministically.
# Callers must remove any previous $JDK_DIR first: this always installs a fresh copy.
unpack_jdk() {
    local archive="$1" stage="$LOCAL/jdk/.unpack"
    rm -rf "$stage"; mkdir -p "$stage"
    tar -xzf "$archive" -C "$stage"
    local candidate
    candidate="$(find "$stage" -mindepth 1 -maxdepth 1 -type d)"
    [[ -n "$candidate" && "$(printf '%s\n' "$candidate" | wc -l | tr -d ' ')" == 1 ]] \
        || fail "JDK archive does not contain exactly one top-level directory; expected $JDK_DIR"
    mv "$candidate" "$JDK_DIR"
    rm -rf "$stage"
}

case "${1:-}" in
bootstrap)
    fetch "$JDK_URL" "$LOCAL/jdk/temurin-21.tar.gz" "$JDK_SHA"
    # A directory without a usable manifest is an incomplete install: a partial extraction, or a
    # leftover from an earlier run. Never adopt it and write a fresh manifest over its old files —
    # that would re-certify whatever happens to be sitting there. Rebuild from the verified archive.
    if [[ ! -d "$JDK_DIR" || ! -s "$LOCAL/jdk/install.sha256" ]]; then
        rm -rf "$JDK_DIR"
        unpack_jdk "$LOCAL/jdk/temurin-21.tar.gz"
        manifest "$JDK_DIR" "$LOCAL/jdk/install.sha256"
    fi
    check_install "$JDK_DIR" "$LOCAL/jdk/install.sha256"
    fetch "$GRADLE_URL" "$LOCAL/gradle-dist/gradle-$GRADLE_VERSION-bin.zip" "$GRADLE_SHA"
    # Same rule as the JDK: a directory that cannot be verified is replaced, not adopted.
    if [[ ! -d "$LOCAL/gradle-dist/gradle-$GRADLE_VERSION" || ! -s "$LOCAL/gradle-dist/install.sha256" ]]; then
        rm -rf "$LOCAL/gradle-dist/gradle-$GRADLE_VERSION"
        unzip -q "$LOCAL/gradle-dist/gradle-$GRADLE_VERSION-bin.zip" -d "$LOCAL/gradle-dist"
        manifest "$LOCAL/gradle-dist/gradle-$GRADLE_VERSION" "$LOCAL/gradle-dist/install.sha256"
    fi
    check_install "$LOCAL/gradle-dist/gradle-$GRADLE_VERSION" "$LOCAL/gradle-dist/install.sha256"
    "$JDK_HOME/bin/java" -version
    echo "Platform: $PLATFORM; Ready: JDK=$JDK_HOME; Gradle=$LOCAL/gradle-dist/gradle-$GRADLE_VERSION"
    ;;
gradle)
    shift
    [[ -x "$JDK_HOME/bin/java" && -f "$LOCAL/jdk/install.sha256" ]] || fail 'Run scripts/dev bootstrap first.'
    check_install "$JDK_DIR" "$LOCAL/jdk/install.sha256"
    export JAVA_HOME="$JDK_HOME" GRADLE_USER_HOME="$LOCAL/gradle-user-home"
    export PATH="$JAVA_HOME/bin:$PATH" TMPDIR="$LOCAL/tmp/"
    cd "$ROOT"
    exec "$ROOT/gradlew" "-Dorg.gradle.java.home=$JAVA_HOME" "-Djava.io.tmpdir=$LOCAL/tmp" \
        "-Porg.gradle.java.installations.paths=$JAVA_HOME" \
        "-Dorg.gradle.jvmargs=-Xmx2g -Dfile.encoding=UTF-8 -Djava.io.tmpdir=$LOCAL/tmp" "$@"
    ;;
*) fail 'Usage: scripts/dev bootstrap | scripts/dev gradle <args>' ;;
esac
